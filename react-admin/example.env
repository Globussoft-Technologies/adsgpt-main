# Copy this file to `.env` and adjust it for your environment. Vite exposes these values to the browser, so never place secrets here.

# VITE_SOCKET_URL is the main Node.js backend URL used by the admin dashboard for API and socket requests.
VITE_SOCKET_URL=http://localhost:7000
# VITE_S3_PREFIX is the public base URL prepended to stored asset paths when the dashboard displays media.
VITE_S3_PREFIX=http://localhost:9000
