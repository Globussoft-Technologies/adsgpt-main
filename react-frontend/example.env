# Copy this file to `.env` and replace every `<...>` placeholder.
# Warning: Vite bundles every `VITE_*` value into the browser. Do not put private credentials or server-only secrets here.

# VITE_AD_FACTORY_WEB_URL is the URL of the external service used by this frontend feature.
VITE_AD_FACTORY_WEB_URL=<vite-ad-factory-web-url>

# VITE_AD_FACTORY_WEB_URL_AUTOFILL is the URL of the external service used by this frontend feature.
VITE_AD_FACTORY_WEB_URL_AUTOFILL=<vite-ad-factory-web-url-autofill>

# VITE_AD_FACTORY_WEB_URL_GETIMAGES is the URL of the external service used by this frontend feature.
VITE_AD_FACTORY_WEB_URL_GETIMAGES=<vite-ad-factory-web-url-getimages>

# VITE_ADS_URL is the ads-search backend URL used to search advertising data.
VITE_ADS_URL=http://localhost:9090
# VITE_AUTH_API_URLS optionally lists additional trusted AdsGPT service origins
# that accept the shared HttpOnly session cookie. Separate URLs with commas.
VITE_AUTH_API_URLS=

# VITE_AGENTIC_URL is the URL of the external service used by this frontend feature.
VITE_AGENTIC_URL=<vite-agentic-url>

# VITE_AI_CAT_SEARCH_URL is the URL of the external service used by this frontend feature.
VITE_AI_CAT_SEARCH_URL=<vite-ai-cat-search-url>

# VITE_AMEMBER_URL is a membership-provider URL used for sign-up, billing, or subscription navigation.
VITE_AMEMBER_URL=<vite-amember-url>

# VITE_APP_FRESHUSER_API is the URL of the external service used by this frontend feature.
VITE_APP_FRESHUSER_API=<vite-app-freshuser-api>

# VITE_APP_PROJECT_VIDEO_EDITOR configures this frontend integration.
VITE_APP_PROJECT_VIDEO_EDITOR=<vite-app-project-video-editor>

# VITE_AUTO_GENERATED_PLAN_ID selects the plan identifier used for this automated frontend flow.
VITE_AUTO_GENERATED_PLAN_ID=<vite-auto-generated-plan-id>

# VITE_CANVA_CLIENT_ID configures the public Canva OAuth client integration used by the browser.
VITE_CANVA_CLIENT_ID=<vite-canva-client-id>

# VITE_CANVA_REDIRECT_URI configures the public Canva OAuth client integration used by the browser.
VITE_CANVA_REDIRECT_URI=<vite-canva-redirect-uri>

# VITE_CANVA_SCOPES configures the public Canva OAuth client integration used by the browser.
VITE_CANVA_SCOPES=<vite-canva-scopes>

# VITE_CREDIT_EXCEEDED_URL is the URL of the external service used by this frontend feature.
VITE_CREDIT_EXCEEDED_URL=<vite-credit-exceeded-url>

# VITE_CREDIT_VARIATION_URL is the URL of the external service used by this frontend feature.
VITE_CREDIT_VARIATION_URL=<vite-credit-variation-url>

# VITE_ENABLE_GOOGLE_POSTING is a feature flag controlling whether this frontend capability is shown.
VITE_ENABLE_GOOGLE_POSTING=false

# VITE_ENABLE_NEW_EDITOR_LAYOUT is a feature flag controlling whether this frontend capability is shown.
VITE_ENABLE_NEW_EDITOR_LAYOUT=false

# VITE_EXPIRED_URL is the URL of the external service used by this frontend feature.
VITE_EXPIRED_URL=<vite-expired-url>

# VITE_FACEBOOK_ANALYTICS_API is the provider API base URL used to retrieve this platform's advertising analytics.
VITE_FACEBOOK_ANALYTICS_API=<vite-facebook-analytics-api>

# VITE_FACEBOOK_SECRET_KEY is the provider key sent by the browser integration; it must be treated as public because Vite exposes it to users.
VITE_FACEBOOK_SECRET_KEY=<vite-facebook-secret-key>

# VITE_FACEBOOK_USER_ID is the provider account/user identifier used with this platform's analytics integration.
VITE_FACEBOOK_USER_ID=<vite-facebook-user-id>

# VITE_FEATURE_AUTOMATION is a feature flag controlling whether this frontend capability is shown.
VITE_FEATURE_AUTOMATION=false

# VITE_FEATURE_LANDING_ANALYZER is a feature flag controlling whether this frontend capability is shown.
VITE_FEATURE_LANDING_ANALYZER=false

# VITE_FEATURE_LEADS_POSTING is a feature flag controlling whether this frontend capability is shown.
VITE_FEATURE_LEADS_POSTING=false

# VITE_FEATURE_META_ADS_CHAT is a feature flag controlling whether this frontend capability is shown.
VITE_FEATURE_META_ADS_CHAT=false

# VITE_FEATURE_PROMPT_CATEGORIES is a feature flag controlling whether this frontend capability is shown.
VITE_FEATURE_PROMPT_CATEGORIES=false

# VITE_FEATURE_WIZARD_V2 is a feature flag controlling whether this frontend capability is shown.
VITE_FEATURE_WIZARD_V2=false

# VITE_GA4_MEASUREMENT_ID identifies the Google Analytics 4 property receiving browser analytics events.
VITE_GA4_MEASUREMENT_ID=<vite-ga4-measurement-id>

# VITE_GOOGLE_ANALYTICS_API is the provider API base URL used to retrieve this platform's advertising analytics.
VITE_GOOGLE_ANALYTICS_API=<vite-google-analytics-api>

# VITE_GOOGLE_SECRET_KEY is the provider key sent by the browser integration; it must be treated as public because Vite exposes it to users.
VITE_GOOGLE_SECRET_KEY=<vite-google-secret-key>

# VITE_GOOGLE_USER_ID is the provider account/user identifier used with this platform's analytics integration.
VITE_GOOGLE_USER_ID=<vite-google-user-id>

# VITE_GUEST_USER_SIGNUP_URL is a membership-provider URL used for sign-up, billing, or subscription navigation.
VITE_GUEST_USER_SIGNUP_URL=<vite-guest-user-signup-url>

# VITE_INSTAGRAM_ANALYTICS_API is the provider API base URL used to retrieve this platform's advertising analytics.
VITE_INSTAGRAM_ANALYTICS_API=<vite-instagram-analytics-api>

# VITE_INSTAGRAM_SECRET_KEY is the provider key sent by the browser integration; it must be treated as public because Vite exposes it to users.
VITE_INSTAGRAM_SECRET_KEY=<vite-instagram-secret-key>

# VITE_INSTAGRAM_USER_ID is the provider account/user identifier used with this platform's analytics integration.
VITE_INSTAGRAM_USER_ID=<vite-instagram-user-id>

# VITE_LINKEDIN_ANALYTICS_API is the provider API base URL used to retrieve this platform's advertising analytics.
VITE_LINKEDIN_ANALYTICS_API=<vite-linkedin-analytics-api>

# VITE_LINKEDIN_SECRET_KEY is the provider key sent by the browser integration; it must be treated as public because Vite exposes it to users.
VITE_LINKEDIN_SECRET_KEY=<vite-linkedin-secret-key>

# VITE_LINKEDIN_USER_ID is the provider account/user identifier used with this platform's analytics integration.
VITE_LINKEDIN_USER_ID=<vite-linkedin-user-id>

# VITE_META_ADS_CHAT_ALLOWED_EMAILS lists the email addresses allowed to access the Meta Ads chat feature.
VITE_META_ADS_CHAT_ALLOWED_EMAILS=<vite-meta-ads-chat-allowed-emails>

# VITE_MODE identifies the frontend environment for environment-specific behavior.
VITE_MODE=development

# VITE_NAS_BASE_URL is the public asset-storage base URL used to render generated media.
VITE_NAS_BASE_URL=<vite-nas-base-url>

# VITE_PINTEREST_ANALYTICS_API is the provider API base URL used to retrieve this platform's advertising analytics.
VITE_PINTEREST_ANALYTICS_API=<vite-pinterest-analytics-api>

# VITE_PINTEREST_SECRET_KEY is the provider key sent by the browser integration; it must be treated as public because Vite exposes it to users.
VITE_PINTEREST_SECRET_KEY=<vite-pinterest-secret-key>

# VITE_PINTEREST_USER_ID is the provider account/user identifier used with this platform's analytics integration.
VITE_PINTEREST_USER_ID=<vite-pinterest-user-id>

# VITE_PROMPT_API is the URL of the external service used by this frontend feature.
VITE_PROMPT_API=<vite-prompt-api>

# VITE_PYTHON_API_CLONE_YOURSELF_FACE_VALIDATE_URL is the URL of the external service used by this frontend feature.
VITE_PYTHON_API_CLONE_YOURSELF_FACE_VALIDATE_URL=<vite-python-api-clone-yourself-face-validate-url>

# VITE_REDDIT_ANALYTICS_API is the provider API base URL used to retrieve this platform's advertising analytics.
VITE_REDDIT_ANALYTICS_API=<vite-reddit-analytics-api>

# VITE_REDDIT_SECRET_KEY is the provider key sent by the browser integration; it must be treated as public because Vite exposes it to users.
VITE_REDDIT_SECRET_KEY=<vite-reddit-secret-key>

# VITE_REDDIT_USER_ID is the provider account/user identifier used with this platform's analytics integration.
VITE_REDDIT_USER_ID=<vite-reddit-user-id>

# VITE_S3_BASE_URL is the public asset-storage base URL used to render generated media.
VITE_S3_BASE_URL=<vite-s3-base-url>

# VITE_SIGNUP_URL is a membership-provider URL used for sign-up, billing, or subscription navigation.
VITE_SIGNUP_URL=<vite-signup-url>

# VITE_SOCKET_URL is the main Node.js backend URL used for API calls and realtime connections.
VITE_SOCKET_URL=http://localhost:7000

# VITE_SUBSCRIPTION_CANCELLATION_URL is a membership-provider URL used for sign-up, billing, or subscription navigation.
VITE_SUBSCRIPTION_CANCELLATION_URL=<vite-subscription-cancellation-url>

# VITE_TIKTOK_COMING_SOON is a feature flag controlling whether this frontend capability is shown.
VITE_TIKTOK_COMING_SOON=false
