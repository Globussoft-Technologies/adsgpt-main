RD_PORT=6379

# RD_USERNAME configures the Redis connection used for caching, queues, and realtime events.
RD_USERNAME=<rd-username>

# RECREATE_ADS_IMAGE_PYTHON_API is the endpoint for the supporting AI service used by this backend feature.
RECREATE_ADS_IMAGE_PYTHON_API=<recreate-ads-image-python-api>

# redisPass configures the Redis connection used for caching, queues, and realtime events.
redisPass=<redispass>

# RESULT_UPDATE_SECRET authenticates trusted service-to-service requests for this protected operation.
RESULT_UPDATE_SECRET=<result-update-secret>

