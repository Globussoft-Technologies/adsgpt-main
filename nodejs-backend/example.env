# UPLOAD_TO_S3 configures whether uploads use S3 instead of NAS storage used for creative assets.
UPLOAD_TO_S3=false

# VOICE_PYTHON_BASE_URL is the endpoint for the supporting AI service used by this backend feature.
VOICE_PYTHON_BASE_URL=<voice-python-base-url>

# VOICE_PYTHON_SARVAM_BASE_URL is the endpoint for the supporting AI service used by this backend feature.
VOICE_PYTHON_SARVAM_BASE_URL=<voice-python-sarvam-base-url>
# Workspace invitations (Mongo-only members)
# Optional plan filters. With both values empty, every active subscription plan
# is eligible to sponsor workspace members.
WORKSPACE_SPONSOR_PLAN_IDS=
WORKSPACE_NON_SPONSOR_PLAN_IDS=
WORKSPACE_EMAIL_FROM=support@adsgpt.io
WORKSPACE_INVITATION_URL_BASE=http://localhost:5173/workspace-invite
WORKSPACE_MEMBER_LOGIN_URL_BASE=http://localhost:5173/workspace-login
WORKSPACE_MEMBER_TOKEN_MINUTES=60
# Invitation link lifetime. Defaults to 7 days when unset; lower it to test
# expiry handling.
WORKSPACE_INVITATION_TTL_MS=604800000
# Rate limits for the unauthenticated /workspace-auth surface. The per-IP cap
# covers every route; the per-email cap additionally throttles password
# sign-in attempts by mailbox, so one account cannot be credential-stuffed
# from rotating IPs.
WORKSPACE_AUTH_RATE_LIMIT_PER_IP=40
WORKSPACE_MEMBER_LOGIN_RATE_LIMIT_PER_EMAIL=8
# Local development only: expose undelivered links in API responses.
WORKSPACE_EXPOSE_INVITATION_LINK=false
