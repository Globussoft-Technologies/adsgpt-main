# AMEMBER_API_KEY configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_API_KEY=<amember-api-key>

# AMEMBER_BASE_API_URL configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_BASE_API_URL=<amember-base-api-url>

# AMEMBER_PLAN_DURATION_DAYS configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_PLAN_DURATION_DAYS=<amember-plan-duration-days>

# AMEMBER_PRODUCT_ID configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_PRODUCT_ID=<amember-product-id>

# AMEMBER_URL configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_URL=<amember-url>

# AMEMBER_SSO_SECRET signs 60-second assertions from the aMember PHP bridge. Use 32+ random characters and keep it identical on aMember and Node.
AMEMBER_SSO_SECRET=<amember-sso-secret>

# AMEMBER_SSO_ISSUER must match the PHP bridge assertion issuer.
AMEMBER_SSO_ISSUER=amember

# AMEMBER_SSO_AUDIENCE must match the PHP bridge assertion audience.
AMEMBER_SSO_AUDIENCE=adsgpt-node

# AMEMBER_SSO_SUCCESS_URL is the frontend origin used after a successful exchange.
AMEMBER_SSO_SUCCESS_URL=<frontend-origin>

# AMEMBER_MEMBER_URL is the aMember member area an expired plan is redirected to,
# for example https://adsgpt-dev.poweradspy.com/amember. Optional: when unset it
# is derived from AMEMBER_BASE_API_URL by dropping the trailing /api.
AMEMBER_MEMBER_URL=<amember-member-url>

# APPLE_BUNDLE_ID configures the Apple App Store Server / Sign-in-with-Apple integration used by the mobile app.
APPLE_BUNDLE_ID=<apple-bundle-id>

# APPLE_ENVIRONMENT selects the App Store Server API environment (Sandbox or Production).
APPLE_ENVIRONMENT=<apple-environment>

# APPLE_ISSUER_ID configures the Apple App Store Server / Sign-in-with-Apple integration used by the mobile app.
APPLE_ISSUER_ID=<apple-issuer-id>

# APPLE_KEY_ID configures the Apple App Store Server / Sign-in-with-Apple integration used by the mobile app.
APPLE_KEY_ID=<apple-key-id>

# APPLE_PRIVATE_KEY is the Apple App Store Server API private key (.p8 contents).
APPLE_PRIVATE_KEY=<apple-private-key>

# AUTH_COOKIE_DOMAIN is the shared parent domain, for example .poweradspy.com in development or .adsgpt.io in production.
AUTH_COOKIE_DOMAIN=<auth-cookie-domain>

# CORS_ALLOWED_ORIGINS is a comma-separated list of trusted frontend origins
# allowed to send credentialed requests. Local development supports
# http://localhost:* to allow any localhost port.
CORS_ALLOWED_ORIGINS=<frontend-origin>


# CRON_ROLE decides whether THIS process runs scheduled work.
#   all     every job (DEFAULT — pre-split behaviour)
#   api     nothing scheduled
#
# THIS SETTING IS FOR THE GATEWAY (index.js). worker.js forces itself to
# "worker" regardless of what is here, because both entrypoints load this same
# file and a worker that inherited "api" would sit there doing nothing. So the
# only value worth putting here is `api`, and only once a worker is actually
# running — with `api` set and no worker, nothing scheduled runs at all,
# Autopilot included.
#
# Leave it as `all` until then. Both processes registering the same job is the
# correct mid-migration state: every job is behind a Redis lock (Autopilot's
# own, or utils/cronLock.js), so one tick still runs exactly once.
CRON_ROLE=all

# AUTOPILOT_ALERT_DRY_RUN_TOO configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_ALERT_DRY_RUN_TOO=false

# AUTOPILOT_ALERT_THROTTLE_MINUTES configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_ALERT_THROTTLE_MINUTES=<autopilot-alert-throttle-minutes>

# AUTOPILOT_CRON configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_CRON=<autopilot-cron>

# AUTOPILOT_DRY_RUN configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_DRY_RUN=true

# Page size for the Autopilot audit's Meta reads. Two ceilings pull against
# each other: every page is a separate API call (call-count / BUC limits), but
# a large page trips "Please reduce the amount of data you're asking for"
# (code 100).
#
# 20 ran clean in production until PR #1448 (2026-09-03) shipped a raise to
# 500 and code 100 returned the same day. Climb back one notch at a time
# (20 -> 50 -> 100), watching for code 100 after each. Defaults: 100 / 20.
AUTOPILOT_ENTITY_PAGE_LIMIT=100
AUTOPILOT_INSIGHTS_PAGE_LIMIT=20

# Wall-clock ceiling on ONE (user, account) in a cycle. The Meta SDK sets no
# HTTP timeout, so without this a dead socket held the run lock for its full
# 55-minute TTL while every remaining user waited. Must stay well under that
# TTL or it bounds nothing. Default 120000 (2 min).
AUTOPILOT_ACCOUNT_TIMEOUT_MS=120000

# Per-account, per-cycle ceilings on what Autopilot may DO. Scale is capped by
# default because budget moves compound across ticks. Pause and resume are
# UNCAPPED by default (0 = no ceiling): a cap does not prevent a mis-tuned
# rule's damage, it paces it, while a half-actioned account keeps spending.
# Set either to a positive integer if Meta starts refusing rapid writes
# (code 10 / subcode 1404078), or for the first few ticks after enabling
# autoResume on an account with a long pause history.
AUTOPILOT_MAX_SCALE_ACTIONS_PER_RUN=10
AUTOPILOT_MAX_PAUSE_ACTIONS_PER_RUN=0
AUTOPILOT_MAX_RESUME_ACTIONS_PER_RUN=0

# AUTOPILOT_EMAIL_FROM configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_EMAIL_FROM=<autopilot-email-from>

# AUTOPILOT_ENABLED configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_ENABLED=false

# AUTOPILOT_LIVE_ACTIONS_ALLOWED configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_LIVE_ACTIONS_ALLOWED=false

# AUTOPILOT_TELEGRAM_BOT_TOKEN configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_TELEGRAM_BOT_TOKEN=<autopilot-telegram-bot-token>

# AUTOPILOT_TELEGRAM_WEBHOOK_SECRET configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_TELEGRAM_WEBHOOK_SECRET=<autopilot-telegram-webhook-secret>

# AUTOPILOT_TELEGRAM_WEBHOOK_URL configures the autopilot scheduler, safety controls, or delivery channel used for automated ad actions.
AUTOPILOT_TELEGRAM_WEBHOOK_URL=<autopilot-telegram-webhook-url>




