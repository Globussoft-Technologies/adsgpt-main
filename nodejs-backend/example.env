# TIKTOK_API_BASE configures ad-platform OAuth or redirects used when connecting advertising accounts.
TIKTOK_API_BASE=<tiktok-api-base>

# TIKTOK_APP_ID configures ad-platform OAuth or redirects used when connecting advertising accounts.
TIKTOK_APP_ID=<tiktok-app-id>

# TIKTOK_APP_SECRET configures ad-platform OAuth or redirects used when connecting advertising accounts.
TIKTOK_APP_SECRET=<tiktok-app-secret>

# TIKTOK_PROXY_URL configures ad-platform OAuth or redirects used when connecting advertising accounts.
TIKTOK_PROXY_URL=<tiktok-proxy-url>

# TIKTOK_REDIRECT_URI configures ad-platform OAuth or redirects used when connecting advertising accounts.
TIKTOK_REDIRECT_URI=<tiktok-redirect-uri>

# TOKEN_EXPIRY_TIME sets the cache/token expiry duration in minutes.
TOKEN_EXPIRY_TIME=1440

# TOP_UP_PLAN_AD_COPY_PRICE configures the membership provider or plan/pricing value used for subscriptions and credits.
TOP_UP_PLAN_AD_COPY_PRICE=<top-up-plan-ad-copy-price>

# TOP_UP_PLAN_AD_CREATIVE_PRICE configures the membership provider or plan/pricing value used for subscriptions and credits.
TOP_UP_PLAN_AD_CREATIVE_PRICE=<top-up-plan-ad-creative-price>

# topUpPlanID configures the membership provider or plan/pricing value used for subscriptions and credits.
topUpPlanID=<topupplanid>

# TRIAL_PLAN_ID configures the membership provider or plan/pricing value used for subscriptions and credits.
TRIAL_PLAN_ID=<trial-plan-id>


# UI_PASSWORD protects the corresponding administrative or Swagger login endpoint.
UI_PASSWORD=<ui-password>

# UI_USERNAME protects the corresponding administrative or Swagger login endpoint.
UI_USERNAME=<ui-username>

# UPLOAD_IMAGE_SECRET_KEY authenticates trusted service-to-service requests for this protected operation.
UPLOAD_IMAGE_SECRET_KEY=<upload-image-secret-key>

# UPLOAD_TO_S3 configures whether uploads use S3 instead of NAS storage used for creative assets.
UPLOAD_TO_S3=false

# VOICE_PYTHON_BASE_URL is the endpoint for the supporting AI service used by this backend feature.
VOICE_PYTHON_BASE_URL=<voice-python-base-url>

# VOICE_PYTHON_SARVAM_BASE_URL is the endpoint for the supporting AI service used by this backend feature.
VOICE_PYTHON_SARVAM_BASE_URL=<voice-python-sarvam-base-url>
# Workspace invitations (Mongo-only members)
# Optional plan filters. With both values empty, every active subscription plan
# is eligible to sponsor workspace members.
WORKSPACE_SPONSOR_PLAN_IDS=
WORKSPACE_NON_SPONSOR_PLAN_IDS=
WORKSPACE_EMAIL_FROM=support@adsgpt.io
WORKSPACE_INVITATION_URL_BASE=http://localhost:5173/workspace-invite
WORKSPACE_MEMBER_LOGIN_URL_BASE=http://localhost:5173/workspace-login
WORKSPACE_MEMBER_TOKEN_MINUTES=60
# Invitation link lifetime. Defaults to 7 days when unset; lower it to test
# expiry handling.
WORKSPACE_INVITATION_TTL_MS=604800000
# Rate limits for the unauthenticated /workspace-auth surface. The per-IP cap
# covers every route; the per-email cap additionally throttles password
# sign-in attempts by mailbox, so one account cannot be credential-stuffed
# from rotating IPs.
WORKSPACE_AUTH_RATE_LIMIT_PER_IP=40
WORKSPACE_MEMBER_LOGIN_RATE_LIMIT_PER_EMAIL=8
# Global apiLimiter budgets, per 15-minute window. Signed-in traffic is keyed
# on the verified JWT subject, so one user behind a shared office NAT or VPN
# no longer eats the whole window for everyone else on that address;
# unauthenticated traffic still falls back to a per-IP bucket. Raise
# API_RATE_LIMIT_PER_USER if legitimate heavy sessions start seeing 429s —
# the server logs every trip as "[rate-limit] 429 ... by=user|ip key=...".
API_RATE_LIMIT_PER_USER=3000
API_RATE_LIMIT_PER_IP=1000
# Local development only: expose undelivered links in API responses.
WORKSPACE_EXPOSE_INVITATION_LINK=false

# ── Meta API usage tracking ──────────────────────────────────────────────────
# Records how many Meta API requests each ad account costs, plus the
# utilisation percentages Meta returns in its own response headers, into
# hourly rows (Module/metaUsage/metaApiUsage.js). All three are optional —
# the defaults are what production should run.

# META_USAGE_TRACKING set to "off" disables recording entirely. On by default:
# the collection is TTL'd and small, and the point is to already have the data
# when someone asks why a request was refused.
META_USAGE_TRACKING=on

# META_USAGE_FLUSH_MS is how often buffered counts are written to Mongo.
# Lower means less data lost if the process dies; higher means fewer writes.
# 30s default — a cron burst of hundreds of calls still costs one bulk write.
META_USAGE_FLUSH_MS=30000

# META_USAGE_RETENTION_DAYS is the TTL on the usage collection. 30 days is
# long enough to investigate "sometime last month" and short enough that a
# per-hour-per-account collection stays small.
META_USAGE_RETENTION_DAYS=30
