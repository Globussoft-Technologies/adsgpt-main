seedream-5.0-lite_IMAGE_CREDIT_DEDUCTION=0

# SENDGRID_API_KEY authorizes SendGrid to send autopilot email alerts.
SENDGRID_API_KEY=<sendgrid-api-key>

# SOCKET_PASSWORD protects the corresponding administrative or Swagger login endpoint.
SOCKET_PASSWORD=<socket-password>

# SOCKET_URL sets the internal/public backend URL used by API documentation or service-to-service requests.
SOCKET_URL=<socket-url>

# SOCKET_USER_NAME protects the corresponding administrative or Swagger login endpoint.
SOCKET_USER_NAME=<socket-user-name>

# SWAGGER_HOST sets the internal/public backend URL used by API documentation or service-to-service requests.
