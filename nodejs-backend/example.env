FREE_PLAN_ID=<free-plan-id>

# FRONTEND_URL configures ad-platform OAuth or redirects used when connecting advertising accounts.
FRONTEND_URL=<frontend-url>

# GEMINI_API_KEY holds the Gemini Central key ISSUED TO THIS SERVICE — not a
# Google API key. ALL Gemini traffic (AI generation, Meta chat, LLM audit) goes
# through the Gemini Central proxy; we do not hold raw Google keys, and this
# key is not valid against Google directly. The variable name is unchanged from
# before the proxy migration but its meaning is: a leftover `AIza…` Google key
# here will be rejected by the proxy. (Python services call this one GLB_KEY.)
# Replaces the former GEMINI_API_KEYS pool.
GEMINI_API_KEY=<gemini-central-key>

# GEMINI_BASE_URL optionally overrides the Gemini Central endpoint. Defaults to
# https://centralized-gemini.globussoft.com/nx/direct — only set this to point
# at a staging proxy.
# GEMINI_BASE_URL=<gemini-central-base-url>

# GEMINI_MODEL optionally overrides the Ads Chat model (MODELS.CHAT in
# services/ai/geminiClient.js). Defaults to gemini-flash-latest.
GEMINI_MODEL=<gemini-model>

# gemini-3.1-flash-image-preview_IMAGE_CREDIT_DEDUCTION defines the number of user credits charged for this generation capability.
gemini-3.1-flash-image-preview_IMAGE_CREDIT_DEDUCTION=0

# gemini-3-pro-image-preview_IMAGE_CREDIT_DEDUCTION defines the number of user credits charged for this generation capability.
gemini-3-pro-image-preview_IMAGE_CREDIT_DEDUCTION=0

# GOOGLE_CLIENT_ID configures ad-platform OAuth or redirects used when connecting advertising accounts.
GOOGLE_CLIENT_ID=<google-client-id>

# GOOGLE_CLIENT_SECRET configures ad-platform OAuth or redirects used when connecting advertising accounts.
GOOGLE_CLIENT_SECRET=<google-client-secret>

# GOOGLE_DEVELOPER_TOKEN configures ad-platform OAuth or redirects used when connecting advertising accounts.
GOOGLE_DEVELOPER_TOKEN=<google-developer-token>

# GOOGLE_REDIRECT_URI configures ad-platform OAuth or redirects used when connecting advertising accounts.
GOOGLE_REDIRECT_URI=<google-redirect-uri>

# gpt-image-1.5_IMAGE_CREDIT_DEDUCTION defines the number of user credits charged for this generation capability.
gpt-image-1.5_IMAGE_CREDIT_DEDUCTION=0

# gpt-image-2_IMAGE_CREDIT_DEDUCTION defines the number of user credits charged for this generation capability.
gpt-image-2_IMAGE_CREDIT_DEDUCTION=0

# HOST configures the Redis connection used for caching, queues, and realtime events.
HOST=localhost

# JWT_SECRET_KEY signs and verifies application JWTs; use a long, unique secret.
JWT_SECRET_KEY=<jwt-secret-key>

# LANDING_PAGE_SCAN_API is the endpoint for the supporting AI service used by this backend feature.
LANDING_PAGE_SCAN_API=<landing-page-scan-api>

# LIFESTYLE_IMAGE_PYTHON_API is the endpoint for the supporting AI service used by this backend feature.
LIFESTYLE_IMAGE_PYTHON_API=<lifestyle-image-python-api>

# META_MCP_API_KEY configures the Meta Ads MCP service used by the Meta chat integration.
META_MCP_API_KEY=<meta-mcp-api-key>

# META_MCP_SERVER_URL configures the Meta Ads MCP service used by the Meta chat integration.
META_MCP_SERVER_URL=<meta-mcp-server-url>

# MODE selects the runtime mode used by feature and logging behavior.
MODE=development

# MONGO_CONNECTION_STRING connects the API to MongoDB, where application data is stored.
MONGO_CONNECTION_STRING=<mongo-connection-string>

# NAS_UPLOAD_URL configures this runtime integration used by the backend.
NAS_UPLOAD_URL=<nas-upload-url>

# NEW_NAS_UPLOAD_URL configures the S3/media-storage integration used for creative assets.
NEW_NAS_UPLOAD_URL=<new-nas-upload-url>


# === PROD COPY REQUIRED: active merged ads-search runtime variables ===
# Copy only this block into nodejs-backend production env before routing /ads
# traffic to nodejs-backend. Do not copy old standalone-service-only vars such
# as PORT, CORS_ORIGIN, PUB_SUB_*, USER_NAME, PASSWORD, or unused fallback vars.

# MEDIA_URL is the base URL prepended to NAS media paths returned by BrandIQ competitor search.
MEDIA_URL=<ads-media-url>

# COMMON_PAS_URL is the Common PAS API base URL used for unified ad-library search.
COMMON_PAS_URL=<common-pas-api-url>

# COMMON_PAS_TOKEN authorizes requests to the Common PAS API.
COMMON_PAS_TOKEN=<common-pas-api-token>

# Competitor Elasticsearch clusters and indexes used by BrandIQ competitor search.
COMPETITOR_ELASTIC_NODE_FB=<facebook-competitor-elasticsearch-node>
COMPETITOR_ELASTIC_USERNAME_FB=<facebook-competitor-elasticsearch-username>
COMPETITOR_ELASTIC_PASSWORD_FB=<facebook-competitor-elasticsearch-password>
COMPETITOR_INDEX_FB=search_mix
COMPETITOR_ELASTIC_NODE_IG=<instagram-competitor-elasticsearch-node>
COMPETITOR_ELASTIC_USERNAME_IG=<instagram-competitor-elasticsearch-username>
COMPETITOR_ELASTIC_PASSWORD_IG=<instagram-competitor-elasticsearch-password>
COMPETITOR_INDEX_IG=instagram_search_mix
COMPETITOR_ELASTIC_NODE_YT=<youtube-competitor-elasticsearch-node>
COMPETITOR_ELASTIC_USERNAME_YT=<youtube-competitor-elasticsearch-username>
COMPETITOR_ELASTIC_PASSWORD_YT=<youtube-competitor-elasticsearch-password>
COMPETITOR_INDEX_YT=youtube_ads_data
COMPETITOR_ELASTIC_NODE_LD=<linkedin-competitor-elasticsearch-node>
COMPETITOR_ELASTIC_USERNAME_LD=<linkedin-competitor-elasticsearch-username>
COMPETITOR_ELASTIC_PASSWORD_LD=<linkedin-competitor-elasticsearch-password>
COMPETITOR_INDEX_LD=linkedin_ads_data
COMPETITOR_ELASTIC_NODE_GDN=<gdn-competitor-elasticsearch-node>
COMPETITOR_ELASTIC_USERNAME_GDN=<gdn-competitor-elasticsearch-username>
COMPETITOR_ELASTIC_PASSWORD_GDN=<gdn-competitor-elasticsearch-password>
COMPETITOR_INDEX_GDN=gdn_search_mix

# === END PROD COPY REQUIRED: merged nodejs-ads-backend runtime variables ===

# OAUTH_AUTH_CODE_TTL_SECONDS configures the OAuth authorization-server behavior and its security limits.
OAUTH_AUTH_CODE_TTL_SECONDS=<seconds>

# OAUTH_AUTHORIZE_TICKET_TTL_SECONDS configures the OAuth authorization-server behavior and its security limits.
OAUTH_AUTHORIZE_TICKET_TTL_SECONDS=<seconds>

# OAUTH_DCR_RATE_LIMIT_PER_HOUR configures the OAuth authorization-server behavior and its security limits.
OAUTH_DCR_RATE_LIMIT_PER_HOUR=<oauth-dcr-rate-limit-per-hour>

# OAUTH_ENABLED configures the OAuth authorization-server behavior and its security limits.
OAUTH_ENABLED=true

# OAUTH_ISSUER_URL configures the OAuth authorization-server behavior and its security limits.
OAUTH_ISSUER_URL=<oauth-issuer-url>

# OAUTH_JWT_ACCESS_TTL_SECONDS configures the OAuth authorization-server behavior and its security limits.
OAUTH_JWT_ACCESS_TTL_SECONDS=<seconds>

# OAUTH_REFRESH_TOKEN_TTL_SECONDS configures the OAuth authorization-server behavior and its security limits.
OAUTH_REFRESH_TOKEN_TTL_SECONDS=<seconds>

# OAUTH_SIGNING_KEY_ROTATION_DAYS configures the OAuth authorization-server behavior and its security limits.
OAUTH_SIGNING_KEY_ROTATION_DAYS=<oauth-signing-key-rotation-days>

# OAUTH_TOKEN_RATE_LIMIT_PER_MIN configures the OAuth authorization-server behavior and its security limits.
OAUTH_TOKEN_RATE_LIMIT_PER_MIN=<oauth-token-rate-limit-per-min>

# PORT sets the HTTP port on which the backend listens.
PORT=7000

