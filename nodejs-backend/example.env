FACEBOOK_REDIRECT_URI=<facebook-redirect-uri>
# Comma-delimited exact custom-scheme callbacks allowed after Facebook OAuth.
FACEBOOK_OAUTH_MOBILE_RETURN_URLS=io.adsgpt.app://meta-connected



# FIREBASE_SERVICE_ACCOUNT_BASE64 provides Firebase Admin credentials for push notifications; encode the service-account JSON as Base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=<firebase-service-account-base64>

