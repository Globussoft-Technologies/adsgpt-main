# AMEMBER_API_KEY configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_API_KEY=<amember-api-key>

# AMEMBER_BASE_API_URL configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_BASE_API_URL=<amember-base-api-url>

# AMEMBER_PLAN_DURATION_DAYS configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_PLAN_DURATION_DAYS=<amember-plan-duration-days>

# AMEMBER_PRODUCT_ID configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_PRODUCT_ID=<amember-product-id>

# AMEMBER_URL configures the membership provider or plan/pricing value used for subscriptions and credits.
AMEMBER_URL=<amember-url>

# AMEMBER_SSO_SECRET signs 60-second assertions from the aMember PHP bridge. Use 32+ random characters and keep it identical on aMember and Node.
AMEMBER_SSO_SECRET=<amember-sso-secret>

# AMEMBER_SSO_ISSUER must match the PHP bridge assertion issuer.
AMEMBER_SSO_ISSUER=amember

# AMEMBER_SSO_AUDIENCE must match the PHP bridge assertion audience.
AMEMBER_SSO_AUDIENCE=adsgpt-node

# AMEMBER_SSO_SUCCESS_URL is the frontend origin used after a successful exchange.
AMEMBER_SSO_SUCCESS_URL=<frontend-origin>

# AMEMBER_MEMBER_URL is the aMember member area an expired plan is redirected to,
# for example https://adsgpt-dev.poweradspy.com/amember. Optional: when unset it
# is derived from AMEMBER_BASE_API_URL by dropping the trailing /api.
AMEMBER_MEMBER_URL=<amember-member-url>

# AUTH_COOKIE_DOMAIN is the shared parent domain, for example .poweradspy.com in development or .adsgpt.io in production.
AUTH_COOKIE_DOMAIN=<auth-cookie-domain>

# CORS_ALLOWED_ORIGINS is a comma-separated list of trusted frontend origins
# allowed to send credentialed requests. Local development supports
# http://localhost:* to allow any localhost port.
CORS_ALLOWED_ORIGINS=<frontend-origin>

# APPS_SAAS_IMAGE_PYTHON_API is the endpoint for the supporting AI service used by this backend feature.
APPS_SAAS_IMAGE_PYTHON_API=<apps-saas-image-python-api>

