# Copy this file to `.env` and replace every `<...>` placeholder. Do not commit `.env`.

# PORT is the HTTP port used by this ads-search API.
PORT=9090
# CORS_ORIGIN optionally restricts browser requests; use your frontend origin (or omit to allow all origins).
CORS_ORIGIN=http://localhost:5173
# USER_NAME is the username required for the Swagger/basic-auth protected endpoints.
USER_NAME=<swagger-username>
# PASSWORD is the password paired with USER_NAME for those protected endpoints.
PASSWORD=<swagger-password>
# SWAGGER_HOST is the public host shown in the generated Swagger specification.
SWAGGER_HOST=http://localhost:9090

# elasticNode1 is the primary Elasticsearch node used for the ads search index.
elasticNode1=http://localhost:9200
# ELASTIC_USERNAME authenticates this service to the primary Elasticsearch cluster.
ELASTIC_USERNAME=<elasticsearch-username>
# ELASTIC_PASSWORD authenticates this service to the primary Elasticsearch cluster.
ELASTIC_PASSWORD=<elasticsearch-password>
# INDEX_NAME is the primary Elasticsearch index searched by this API.
INDEX_NAME=<ads-index-name>

# PUB_SUB_HOST is the Redis-compatible host used for publishing ads-data events.
PUB_SUB_HOST=localhost
# PUB_SUB_PORT is the Redis-compatible port used for publishing ads-data events.
PUB_SUB_PORT=6379
# PUB_SUB_USERNAME authenticates the publisher to Redis when ACL authentication is enabled.
PUB_SUB_USERNAME=<redis-username>
# PUB_SUB_PASSWORD authenticates the publisher to Redis.
PUB_SUB_PASSWORD=<redis-password>
# ADS_DATA is the Redis channel name on which ads-data events are published.
ADS_DATA=adsData

# JWT_SECRET_KEY verifies JWTs sent to this service; it must match the token issuer's signing secret.
JWT_SECRET_KEY=<long-random-jwt-secret>

# MEDIA_URL is the base URL prepended to legacy ad-media paths.
MEDIA_URL=http://localhost:8080/
# MEDIA_UR_NEW_NAS is the base URL prepended to NAS-hosted media paths.
MEDIA_UR_NEW_NAS=http://localhost:8080
# PAS_REDIRECT_URL is the PowerAdSpy application base URL used when constructing ad-detail links.
PAS_REDIRECT_URL=http://localhost:5173/

# GATEWAY_URL is the main backend URL used to retrieve chat data for search results.
GATEWAY_URL=http://localhost:7000
# EMBEDDING_URL is the embedding service URL used for semantic search requests.
EMBEDDING_URL=http://localhost:8000
# COMMON_PAS_URL is the Common PAS API base URL used for its ads search endpoint.
COMMON_PAS_URL=<common-pas-api-url>
# COMMON_PAS_TOKEN authorizes requests to the Common PAS API.
COMMON_PAS_TOKEN=<common-pas-api-token>

# FB_PAS_URL is the Facebook ads provider API base URL.
FB_PAS_URL=<facebook-provider-api-url>
# INST_PAS_URL is the Instagram ads provider API base URL.
INST_PAS_URL=<instagram-provider-api-url>
# GT_PAS_URL is the Google text ads provider API base URL.
GT_PAS_URL=<google-text-provider-api-url>
# YT_PAS_URL is the YouTube ads provider API base URL.
YT_PAS_URL=<youtube-provider-api-url>
# PINT_PAS_URL is the Pinterest ads provider API base URL.
PINT_PAS_URL=<pinterest-provider-api-url>
# REDDIT_PAS_URL is the Reddit ads provider API base URL.
REDDIT_PAS_URL=<reddit-provider-api-url>
# LINKEDIN_PAS_URL is the LinkedIn ads provider API base URL.
LINKEDIN_PAS_URL=<linkedin-provider-api-url>
# GDN_PAS_URL is the Google Display Network provider API base URL.
GDN_PAS_URL=<gdn-provider-api-url>

# COMPETITOR_ELASTIC_NODE_FB is the Elasticsearch node containing Facebook competitor ads.
COMPETITOR_ELASTIC_NODE_FB=http://localhost:9200
# COMPETITOR_ELASTIC_USERNAME_FB authenticates access to the Facebook competitor-ads cluster.
COMPETITOR_ELASTIC_USERNAME_FB=<elasticsearch-username>
# COMPETITOR_ELASTIC_PASSWORD_FB authenticates access to the Facebook competitor-ads cluster.
COMPETITOR_ELASTIC_PASSWORD_FB=<elasticsearch-password>
# COMPETITOR_INDEX_FB is the Facebook competitor-ads Elasticsearch index.
COMPETITOR_INDEX_FB=search_mix

# COMPETITOR_ELASTIC_NODE_IG is the Elasticsearch node containing Instagram competitor ads.
COMPETITOR_ELASTIC_NODE_IG=http://localhost:9200
# COMPETITOR_ELASTIC_USERNAME_IG authenticates access to the Instagram competitor-ads cluster.
COMPETITOR_ELASTIC_USERNAME_IG=<elasticsearch-username>
# COMPETITOR_ELASTIC_PASSWORD_IG authenticates access to the Instagram competitor-ads cluster.
COMPETITOR_ELASTIC_PASSWORD_IG=<elasticsearch-password>
# COMPETITOR_INDEX_IG is the Instagram competitor-ads Elasticsearch index.
COMPETITOR_INDEX_IG=instagram_search_mix

# COMPETITOR_ELASTIC_NODE_YT is the Elasticsearch node containing YouTube competitor ads.
COMPETITOR_ELASTIC_NODE_YT=http://localhost:9200
# COMPETITOR_ELASTIC_USERNAME_YT authenticates access to the YouTube competitor-ads cluster.
COMPETITOR_ELASTIC_USERNAME_YT=<elasticsearch-username>
# COMPETITOR_ELASTIC_PASSWORD_YT authenticates access to the YouTube competitor-ads cluster.
COMPETITOR_ELASTIC_PASSWORD_YT=<elasticsearch-password>
# COMPETITOR_INDEX_YT is the YouTube competitor-ads Elasticsearch index.
COMPETITOR_INDEX_YT=youtube_ads_data

# COMPETITOR_ELASTIC_NODE_GG is the Elasticsearch node reserved for Google competitor ads.
COMPETITOR_ELASTIC_NODE_GG=http://localhost:9200
# COMPETITOR_ELASTIC_USERNAME_GG authenticates access to the Google competitor-ads cluster.
COMPETITOR_ELASTIC_USERNAME_GG=<elasticsearch-username>
# COMPETITOR_ELASTIC_PASSWORD_GG authenticates access to the Google competitor-ads cluster.
COMPETITOR_ELASTIC_PASSWORD_GG=<elasticsearch-password>
# COMPETITOR_INDEX_GG is the Google competitor-ads Elasticsearch index.
COMPETITOR_INDEX_GG=google_ads_data

# COMPETITOR_ELASTIC_NODE_LD is the Elasticsearch node containing LinkedIn competitor ads.
COMPETITOR_ELASTIC_NODE_LD=http://localhost:9200
# COMPETITOR_ELASTIC_USERNAME_LD authenticates access to the LinkedIn competitor-ads cluster.
COMPETITOR_ELASTIC_USERNAME_LD=<elasticsearch-username>
# COMPETITOR_ELASTIC_PASSWORD_LD authenticates access to the LinkedIn competitor-ads cluster.
COMPETITOR_ELASTIC_PASSWORD_LD=<elasticsearch-password>
# COMPETITOR_INDEX_LD is the LinkedIn competitor-ads Elasticsearch index.
COMPETITOR_INDEX_LD=linkedin_ads_data

# COMPETITOR_ELASTIC_NODE_GDN is the Elasticsearch node containing Google Display Network competitor ads.
COMPETITOR_ELASTIC_NODE_GDN=http://localhost:9200
# COMPETITOR_ELASTIC_USERNAME_GDN authenticates access to the GDN competitor-ads cluster.
COMPETITOR_ELASTIC_USERNAME_GDN=<elasticsearch-username>
# COMPETITOR_ELASTIC_PASSWORD_GDN authenticates access to the GDN competitor-ads cluster.
COMPETITOR_ELASTIC_PASSWORD_GDN=<elasticsearch-password>
# COMPETITOR_INDEX_GDN is the GDN competitor-ads Elasticsearch index.
COMPETITOR_INDEX_GDN=gdn_search_mix
